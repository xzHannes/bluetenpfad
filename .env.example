# Blütenpfad — Beispielkonfiguration.
# Kopieren nach `.env` (lokal) bzw. `/etc/bluetenpfad.env` (Server).
# NIEMALS mit echten Werten committen.

# ── Netzwerk ────────────────────────────────────────────────────
WB_HTTP_PORT=8068
WB_HTTPS_PORT=8069
WB_HOST=0.0.0.0
# Hinter einem Reverse-Proxy (Caddy/nginx): auf 1 setzen.
# Dann bindet der Prozess nur auf 127.0.0.1 und vertraut X-Forwarded-*.
TRUST_PROXY=0
NODE_ENV=development

# ── Pfade ───────────────────────────────────────────────────────
# Unterhalb von WB_MEDIA_DIR entstehen uploads/ und thumbs/.
WB_MEDIA_DIR=./media
WB_DATA_DIR=./data
WB_CERT_DIR=./certs

# ── CSRF / Origin-Allowlist ─────────────────────────────────────
# Kommagetrennt. Leer lassen = nur Same-Origin + LAN-Dev-Bereiche.
WB_ALLOWED_ORIGINS=

# ── Arterkennung (optional) ─────────────────────────────────────
# Ohne Key läuft die App, nur die Auto-Bestimmung ist dann aus.
PLANTNET_API_KEY=
INSECT_ID_API_KEY=

# ── E-Mail-Verifizierung (optional, per Schalter) ───────────────
EMAIL_VERIFICATION=0
APP_BASE_URL=http://localhost:8068
# Entweder Brevo-HTTP-API (Port 443, funktioniert auch wenn SMTP geblockt ist) …
BREVO_API_KEY=
# … oder klassisches SMTP:
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Bluetenpfad <noreply@example.de>

# ── Admin-Panel (optional) ──────────────────────────────────────
# Ohne ADMIN_USER + ADMIN_PASSWORD ist /admin komplett deaktiviert.
ADMIN_USER=
ADMIN_PASSWORD=
# Alternative zum Klartext-Passwort: scrypt-Hash
ADMIN_PASSWORD_HASH=
# Optionale IP-Allowlist, kommagetrennt
ADMIN_ALLOWED_IPS=
